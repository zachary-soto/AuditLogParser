# -------------------- Utility Functions --------------------
def compute_sha256(file_path):
    sha256 = hashlib.sha256()
    with open(file_path, "rb") as f:
        for block in iter(lambda: f.read(65536), b""):
            sha256.update(block)
    return sha256.hexdigest()

def init_log_file(output_path):
    base = os.path.splitext(output_path)[0]
    return base + ".log"

def log(message):
    timestamp = datetime.datetime.now().strftime("[%Y-%m-%d %H:%M:%S] ")
    full_message = timestamp + message
    console.insert(tk.END, full_message + "\n")
    console.see(tk.END)
    app.update_idletasks()

    log_path = log_file_path.get()
    if log_path:
        with open(log_path, "a", encoding="utf-8") as f:
            f.write(full_message + "\n")

def update_progress(percent):
    progress_bar['value'] = percent
    app.update_idletasks()

def update_phase_progress(percent):
    phase_bar['value'] = percent
    app.update_idletasks()

# -------------------- File Processing Logic --------------------
def process_file(filepath, output_path, log_fn, progress_fn):
    try:
        start_time = datetime.datetime.now()
        log_fn(f"🕒 Start time: {start_time.strftime('%Y-%m-%d %H:%M:%S')}")
        start_time_label.config(text=f"Start: {start_time.strftime('%Y-%m-%d %H:%M:%S')}")

        current_task.set("Reading input file...")
        update_phase_progress(30)
        ext = os.path.splitext(filepath)[-1].lower()
        if ext == '.xlsx':
            log_fn("Reading Excel file...")
            df = pd.read_excel(filepath)
        elif ext == '.csv':
            log_fn("Reading CSV file...")
            df = pd.read_csv(filepath)
        else:
            raise ValueError("Unsupported file type. Only .xlsx and .csv are supported.")
        progress_fn(5)

        if 'AuditData' not in df.columns:
            raise KeyError("Column 'AuditData' not found in file.")

        current_task.set("Parsing AuditData...")
        log_fn("Parsing AuditData JSON...")
        parsed_data = []
        total = len(df)

        for idx, cell in enumerate(df['AuditData']):
            if cancel_flag.get():
                current_task.set("Cancelled.")
                log_fn("❌ Cancelled by user.")
                return None

            if pd.notnull(cell):
                try:
                    parsed = json.loads(cell)
                    parsed_data.append(parsed)
                except json.JSONDecodeError:
                    parsed_data.append({})
                    log_fn(f"⚠️  Row {idx+1}: Invalid JSON. Skipping.")
            else:
                parsed_data.append({})

            if idx % 100 == 0 or idx == total - 1:
                parse_progress = int((idx + 1) / total * 65)
                progress_fn(5 + parse_progress)
                update_phase_progress(int((idx + 1) / total * 100))

        current_task.set("Flattening JSON data...")
        update_phase_progress(50)
        log_fn("Flattening JSON and combining with original data...")
        json_df = pd.json_normalize(parsed_data)
        new_columns = json_df.columns.tolist()
        df = df.drop(columns=['AuditData'])
        df_combined = pd.concat([df, json_df], axis=1)
        progress_fn(75)

        current_task.set("Writing Excel file...")
        update_phase_progress(80)
        log_fn(f"Writing Excel file to {output_path}...")
        df_combined.to_excel(output_path, index=False)
        progress_fn(85)

        current_task.set("Styling Excel headers...")
        update_phase_progress(90)
        log_fn("Styling new JSON headers...")
        wb = load_workbook(output_path)
        ws = wb.active
        yellow_fill = PatternFill(start_color="FFFF99", end_color="FFFF99", fill_type="solid")

        for col_idx, cell in enumerate(ws[1], start=1):
            if cell.value in new_columns:
                ws.cell(row=1, column=col_idx).fill = yellow_fill

        progress_fn(95)
        wb.save(output_path)

        end_time = datetime.datetime.now()
        duration = end_time - start_time
        log_fn(f"🕔 Finish time: {end_time.strftime('%Y-%m-%d %H:%M:%S')}")
        log_fn(f"⏱ Duration: {str(duration)}")
        finish_time_label.config(text=f"Finish: {end_time.strftime('%Y-%m-%d %H:%M:%S')}")
        duration_label.config(text=f"Duration: {str(duration)}")

        current_task.set("Done.")
        log_fn("✅ Export and styling complete!")
        progress_fn(100)
        update_phase_progress(100)
        return output_path

    except Exception as e:
        raise e

